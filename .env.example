# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.
# API key from https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=
# Where contact form messages are delivered (comma-separate for several)
CONTACT_TO_EMAIL=
# Sender shown on the email. Must be on a domain you verified in Resend.
# Leave empty while testing to use onboarding@resend.dev (only delivers to your own Resend account email).
CONTACT_FROM_EMAIL=
